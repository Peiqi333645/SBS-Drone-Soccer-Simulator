; Engine configuration file.
; SkySim — open-source Godot 4 drone simulator.

config_version=5

[application]

config/name="SBS 无人机足球模拟器"
config/description="面向无人机足球学员的遥控器训练与穿门得分模拟器。"
run/main_scene="res://demo/main_menu.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://demo/scripts/input_setup.gd"
InputProfile="*res://demo/scripts/input_profile.gd"

[physics]

common/physics_ticks_per_second=400
common/enable_object_picking=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
